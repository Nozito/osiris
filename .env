# =====================================================================
# EMAILJS — Configuration pour l'envoi automatique des devis
# ---------------------------------------------------------------------
# 1. Créer un compte sur https://www.emailjs.com (gratuit : 200 mails/mois)
# 2. Aller dans "Email Services" → ajouter votre compte Gmail / Outlook
# 3. Aller dans "Email Templates" → créer un template (voir ci-dessous)
# 4. Copier les IDs dans les variables ci-dessous
# =====================================================================

VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=XXXXXXXXXXXXXXXXXXXXXX

# ─────────────────────────────────────────────────────────────────────
# Template EmailJS recommandé (coller dans l'éditeur de template) :
# Sujet : Nouvelle demande de devis Osiris — {{site_type}}
#
# Corps :
# Nouvelle demande de devis reçue le {{date}}
#
# CLIENT
# Prénom : {{first_name}}
# Nom : {{last_name}}
# Email : {{client_email}}
# Téléphone : {{phone}}
#
# CONFIGURATION
# Offre de base : {{site_type}} — {{base_price}} €
# Pages supplémentaires : {{extra_pages}}
# Upgrades : {{upgrades}}
# Options : {{options}}
# Délai : {{deadline}}
#
# TARIFICATION
# Sous-total HT : {{subtotal_ht}} €
# Supplément délai : {{deadline_surcharge}} €
# Total HT : {{total_ht}} €
# TVA 20% : {{tva}} €
# TOTAL TTC : {{total_ttc}} €
#
# MESSAGE
# {{message}}
# ─────────────────────────────────────────────────────────────────────
