# =====================================================================
# RESEND — Configuration pour l'envoi des emails (Netlify Functions)
# ---------------------------------------------------------------------
# 1. Créer un compte sur https://resend.com
# 2. Ajouter et vérifier votre domaine (ex: osiris-web.com)
# 3. Générer une API key dans Settings > API Keys
# 4. Copier les valeurs ci-dessous
# 5. Dans Netlify : Site settings > Environment variables — ajouter les mêmes
#    (RESEND_API_KEY, FROM_EMAIL, ANTOINE_EMAIL, NOAH_EMAIL)
# =====================================================================

RESEND_API_KEY=re_dUMj3NyP_FMzQZ1RtD5PAjgBjS1uuo8q9

# Email expéditeur (doit correspondre à votre domaine vérifié sur Resend)
FROM_EMAIL=no-reply@osiris-web.com

# Emails de l'équipe — recevront le recap de chaque demande
ANTOINE_EMAIL=antoine@osiris-agency.fr
NOAH_EMAIL=noah@osiris-agency.fr

# ─────────────────────────────────────────────────────────────────────
# Template EmailJS recommandé (coller dans l'éditeur de template) :
# Sujet : Nouvelle demande de devis Osiris — {{site_type}}
#
# Corps :
# Nouvelle demande de devis reçue le {{date}}
#
# CLIENT
# Prénom : {{first_name}}
# Nom : {{last_name}}
# Email : {{client_email}}
# Téléphone : {{phone}}
#
# CONFIGURATION
# Offre de base : {{site_type}} — {{base_price}} €
# Pages supplémentaires : {{extra_pages}}
# Upgrades : {{upgrades}}
# Options : {{options}}
# Délai : {{deadline}}
#
# TARIFICATION
# Sous-total HT : {{subtotal_ht}} €
# Supplément délai : {{deadline_surcharge}} €
# Total HT : {{total_ht}} €
# TVA 20% : {{tva}} €
# TOTAL TTC : {{total_ttc}} €
#
# MESSAGE
# {{message}}
# ─────────────────────────────────────────────────────────────────────
